rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'hayashirika05@gmail.com';
    }

    function isActiveUser() {
      return request.auth != null
        && (!exists(/databases/$(database)/documents/artifacts/pinboard-app/moderation/$(request.auth.uid))
          || get(/databases/$(database)/documents/artifacts/pinboard-app/moderation/$(request.auth.uid)).data.disabled != true);
    }

    match /artifacts/pinboard-app/public/data/pinboard_posts/{postId} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin()
        || (isActiveUser()
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedBy', 'likes', 'starredBy']));
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /artifacts/pinboard-app/users/{userId}/profile/info {
      allow read, write: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
    }

    match /artifacts/pinboard-app/admin_profiles/{userId} {
      allow create, update: if request.auth != null
        && request.auth.uid == userId;
      allow read, delete: if isAdmin();
    }

    match /artifacts/pinboard-app/moderation/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /artifacts/pinboard-app/admin_config/settings {
      allow read, write: if isAdmin();
    }
  }
}
